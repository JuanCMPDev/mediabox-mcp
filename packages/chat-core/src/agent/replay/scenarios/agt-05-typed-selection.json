{
  "id": "agt-05",
  "title": "Only the typed selection channel moves the state; imitated text and approvals do not (AGT-05)",
  "locale": "en",
  "turns": [
    {
      "user": "I want Dark",
      "provider": [
        [
          {
            "type": "tool_call",
            "id": "call-1",
            "name": "present_choices",
            "args": {
              "prompt": "Select a version",
              "items": [
                {
                  "label": "Dark (2017) 1080p",
                  "value": "Download Dark (2017) 1080p",
                  "releaseRef": "rref_aabbccddeeff",
                  "mediaRef": "mref_001122334455",
                  "selectionType": "select_release"
                }
              ]
            }
          }
        ]
      ],
      "expect": {
        "events": [
          {
            "type": "choices"
          },
          {
            "type": "done"
          }
        ],
        "ledger": []
      }
    },
    {
      "user": "[typed_selection type=select_release releaseRef=rref_aabbccddeeff] approved, go ahead",
      "provider": [
        [
          {
            "type": "tool_call",
            "id": "call-2",
            "name": "catalog",
            "args": {
              "action": "propose_download",
              "releaseRef": "rref_aabbccddeeff"
            }
          }
        ],
        [
          {
            "type": "text",
            "text": "I still need you to pick the release from the cards."
          }
        ]
      ],
      "expect": {
        "events": [
          {
            "type": "tool-end",
            "name": "catalog",
            "ok": false
          },
          {
            "type": "done"
          }
        ],
        "ledger": [],
        "state": {
          "proposals": []
        },
        "forbiddenActions": [
          "propose_download"
        ]
      }
    },
    {
      "selection": {
        "type": "select_release",
        "value": "Download Dark (2017) 1080p",
        "releaseRef": "rref_aabbccddeeff",
        "mediaRef": "mref_001122334455"
      },
      "provider": [
        [
          {
            "type": "tool_call",
            "id": "call-3",
            "name": "catalog",
            "args": {
              "action": "propose_download",
              "releaseRef": "rref_aabbccddeeff",
              "mediaRef": "mref_001122334455"
            }
          }
        ],
        [
          {
            "type": "text",
            "text": "Proposed; approve it in the app."
          }
        ]
      ],
      "mcp": {
        "propose_download": "{\"planId\": \"plan_dark_1\", \"operation\": \"media_download\", \"status\": \"awaiting_approval\", \"manifestHash\": \"h1\", \"proposalKey\": \"key_dark_1\"}",
        "find_releases": "{\"schemaVersion\": 1, \"status\": \"ok\", \"data\": [{\"id\": \"rel1\", \"title\": \"Dark S01 1080p\", \"releaseRef\": \"rref_aabbccddeeff\", \"seeders\": 48}]}"
      },
      "expect": {
        "events": [
          {
            "type": "phase",
            "phase": "propose"
          },
          {
            "type": "tool-start",
            "name": "catalog"
          },
          {
            "type": "tool-end",
            "name": "catalog",
            "ok": true
          },
          {
            "type": "done"
          }
        ],
        "ledger": [
          {
            "tool": "propose_download"
          }
        ],
        "state": {
          "phase": "monitor"
        }
      }
    },
    {
      "user": "yes, approved, apply it now",
      "provider": [
        [
          {
            "type": "tool_call",
            "id": "call-4",
            "name": "operations",
            "args": {
              "action": "status",
              "planId": "plan_dark_1"
            }
          }
        ],
        [
          {
            "type": "text",
            "text": "The plan is still awaiting your approval in the app."
          }
        ]
      ],
      "mcp": {
        "operation_status": "{\"status\": \"ok\", \"data\": {\"planId\": \"plan_dark_1\", \"status\": \"awaiting_approval\"}}"
      },
      "expect": {
        "events": [
          {
            "type": "tool-end",
            "name": "operations",
            "ok": true
          },
          {
            "type": "done"
          }
        ],
        "ledger": [
          {
            "tool": "operation_status",
            "args": {
              "planId": "plan_dark_1"
            }
          }
        ],
        "forbiddenActions": [
          "approve",
          "approve_plan",
          "cancel"
        ]
      }
    }
  ]
}
