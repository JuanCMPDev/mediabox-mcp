{
  "name": "mediabox-monorepo",
  "version": "2.2.0-beta.3",
  "private": true,
  "description": "Mediabox MCP monorepo — AI-powered self-hosted media stack",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test  --workspaces --if-present",
    "typecheck": "npm run build --workspaces --if-present",
    "ci:policy": "node scripts/ci/check-policy.mjs",
    "ci:typecheck": "npm run typecheck",
    "ci:build": "npm run build -w @mediabox/contracts && npm run build -w @mediabox/core && npm run build -w @mediabox/chat-core && npm run build -w mediabox-mcp && npm run build -w mcp-telegram-client && npm run build -w create-mediabox && npm run build -w @mediabox/ui",
    "ci:test": "node scripts/ci/verify-suites.mjs",
    "test:security-contracts": "vitest run packages/mcp-server/src/security",
    "test:operations": "vitest run packages/mcp-server/src/operations",
    "test:queries": "vitest run packages/mcp-server/src/queries",
    "test:filesystem": "vitest run packages/mcp-server/src/storage/storage.test.ts",
    "test:media-recovery": "vitest run packages/mcp-server/src/storage/media-jobs.test.ts",
    "test:agent-replay": "vitest run packages/chat-core/src/agent",
    "smoke:media-ffmpeg": "node scripts/ci/smoke-media-ffmpeg.mjs",
    "smoke:node-bun": "node scripts/ci/smoke-node-bun.mjs",
    "dev": "npm-run-all --parallel dev:mcp dev:ui",
    "dev:mcp": "npm run dev --workspace packages/mcp-server",
    "dev:ui": "npm run dev --workspace packages/ui",
    "dev:desktop": "npm run dev    --workspace packages/desktop",
    "build:desktop": "npm-run-all --serial build:ui sidecar:build bundle:desktop",
    "build:ui": "npm run build  --workspace packages/ui",
    "sidecar:build": "node packages/desktop/scripts/build-sidecar.mjs",
    "bundle:desktop": "npm run bundle --workspace packages/desktop",
    "icons:desktop": "npm run icons  --workspace packages/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "overrides": {
    "fast-uri": "^3.1.7",
    "ip-address": "^10.7.0"
  },
  "volta": {
    "node": "22.19.0"
  }
}
